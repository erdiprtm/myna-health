{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker (no script): the static Astro build. Top level = PRODUCTION,
  // env.preview = per-PR previews. Production changes only through CI.
  "name": "myna-health-site",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // mynahealth.id and www point at this Worker (docs/DNS.md). Custom domains need the active
  // Cloudflare zone and no existing A/CNAME record on the hostname.
  "routes": [
    { "pattern": "mynahealth.id", "custom_domain": true },
    { "pattern": "www.mynahealth.id", "custom_domain": true }
  ],
  "env": {
    // routes are inheritable: previews must never claim the production hostnames.
    "preview": { "routes": [] }
  }
}
