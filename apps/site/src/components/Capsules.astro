---
// The Myna capsule supergraphic (brand guideline 2026, cover and closing slides): vertical pills
// and circles in electric blue, cyan and sky on navy, with people photos cropped into them.
// Decorative: every tile is aria-hidden with an empty alt, so screen readers skip the collage.
// "hero" is the big composition for the home page; "cta" is the small one for closing panels.
interface Props {
  variant?: "hero" | "cta";
}
const { variant = "hero" } = Astro.props;
---

{
  variant === "hero" ? (
    <div class="grid w-full grid-cols-3 gap-3 sm:gap-4" aria-hidden="true">
      <div class="flex flex-col gap-3 sm:gap-4">
        <div class="capsule capsule-rise rise-1 aspect-square bg-soft">
          <img src="/images/hero-jogging-pontianak.jpg" alt="" width="1120" height="1400" fetchpriority="high" class="object-[50%_30%]" />
        </div>
        <div class="capsule capsule-rise rise-2 aspect-[1/2.1] bg-electric" />
      </div>
      <div class="flex flex-col gap-3 sm:gap-4">
        <div class="capsule capsule-rise rise-3 aspect-[1/2.1] bg-cyan" />
        <div class="capsule capsule-rise rise-4 aspect-square bg-soft">
          <img src="/images/gym-cek-hp.jpg" alt="" width="1600" height="1067" class="object-[60%_35%]" />
        </div>
      </div>
      <div class="flex flex-col gap-3 sm:gap-4">
        <div class="capsule capsule-rise rise-5 aspect-square bg-electric" />
        <div class="capsule capsule-rise rise-6 relative aspect-[1/2.1] bg-sky">
          <div class="capsule absolute inset-x-0 top-0 aspect-square border-4 border-navy bg-soft">
            <img src="/images/kapsul-pasangan-dapur.jpg" alt="" width="900" height="600" class="object-[45%_40%]" />
          </div>
        </div>
      </div>
      <div class="capsule capsule-rise rise-7 col-span-3 aspect-[3/1] bg-cyan">
        <img src="/images/kapsul-pasangan-stretching.jpg" alt="" width="900" height="600" class="object-[50%_32%]" />
      </div>
    </div>
  ) : (
    <div class="grid w-full max-w-[230px] grid-cols-2 gap-3" aria-hidden="true">
      <div class="capsule aspect-[1/1.9] bg-cyan" />
      <div class="flex flex-col gap-3">
        <div class="capsule aspect-square bg-electric" />
        <div class="capsule aspect-square bg-soft">
          <img src="/images/kapsul-pasangan-stretching.jpg" alt="" width="900" height="600" loading="lazy" class="object-[50%_30%]" />
        </div>
      </div>
      <div class="capsule col-span-2 aspect-[2.4/1] bg-sky">
        <img src="/images/kapsul-pasangan-dapur.jpg" alt="" width="900" height="600" loading="lazy" class="object-[45%_40%]" />
      </div>
    </div>
  )
}
