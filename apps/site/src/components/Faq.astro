---
import { faqs } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  items?: { q: string; a: string }[];
}
const { items = faqs } = Astro.props;
---

<div class="border-t border-foreground/80">
  {
    items.map((item) => (
      <details class="border-b border-border">
        <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 py-5 text-left text-[17px] font-medium text-foreground">
          {item.q}
          <Icon name="chevron-down" class="faq-chevron h-4 w-4 text-muted-foreground transition-transform duration-150" />
        </summary>
        <p class="body-copy max-w-[62ch] pb-6">{item.a}</p>
      </details>
    ))
  }
</div>
