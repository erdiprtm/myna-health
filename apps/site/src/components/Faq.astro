---
import { faqs } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  items?: { q: string; a: string }[];
}
const { items = faqs } = Astro.props;
---

<div class="space-y-2">
  {
    items.map((item) => (
      <details class="rounded-xl border border-border/60 bg-card px-5">
        <summary class="flex cursor-pointer items-center justify-between gap-3 py-5 text-left text-base font-medium text-foreground">
          {item.q}
          <Icon name="chevron-down" class="faq-chevron h-4 w-4 text-muted-foreground transition-transform duration-200" />
        </summary>
        <p class="pb-5 leading-relaxed text-muted-foreground">{item.a}</p>
      </details>
    ))
  }
</div>
