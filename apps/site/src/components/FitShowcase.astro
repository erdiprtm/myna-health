---
import { mynaFitUrl } from "../lib/site";
// Myna Fit, shown with its own interface: three screens captured from fit.mynahealth.id (P-010).
// The phone cycles through them while the matching feature line fills (P-015, Motion):
// it runs only while the block is on screen, pauses on hover or keyboard focus, and each feature
// line is a button that opens its screen. Without JS a CSS loop does the same; with reduced
// motion nothing moves and the buttons switch screens instantly. Each screen has one short note
// beside the phone (P-016, Bevel), saying only what that screen visibly shows. Phones too narrow
// to fit a note beside the frame skip them rather than cover the screen. P-017: set on the navy
// band, the phone sits centred with pill tabs under it (Revolut's card switcher pattern).
const screens = [
  {
    src: "/images/fit-layar-latihan.webp",
    alt: "Layar Myna Fit: latihan hari ini, Bench Press Barbell set 1 dan 2 dengan beban dan repetisi, lalu timer istirahat",
    note: "Saran beban dari sesi lalu",
    notePos: "top-[45%] right-[80%]",
    title: "Program latihan harian",
    body: "Gerakan, set, dan waktu istirahat untuk hari ini, lengkap dengan angka sesi sebelumnya.",
  },
  {
    src: "/images/fit-layar-progres.webp",
    alt: "Layar Myna Fit: grafik progres beban Bench Press selama tiga minggu dan catatan latihan tujuh hari terakhir",
    note: "Grafik beban per gerakan",
    notePos: "top-[30%] left-[80%]",
    title: "Progres tiap gerakan",
    body: "Grafik beban, rekor pribadi, dan catatan latihan tujuh hari terakhir.",
  },
  {
    src: "/images/fit-layar-scan.webp",
    alt: "Layar Myna Fit: contoh hasil scan foto sepiring nasi dan lauk dengan perkiraan kalori tiap makanan",
    note: "Perkiraan per lauk",
    notePos: "top-[42%] left-[82%]",
    title: "Scan foto makanan",
    body: "Foto makanan Anda, lalu lihat perkiraan kalori dan protein dari isi piring.",
  },
];
---

<article id="myna-fit" data-fit class="scroll-mt-24">
  <div class="flex justify-center">
    <div class="fit-phone relative">
      <div class="fit-screen" id="fit-screen" aria-live="polite">
        {
          screens.map((s, i) => (
            <img
              src={s.src}
              alt={s.alt}
              width="600"
              height="1032"
              loading="lazy"
              class:list={["fit-slide", `fit-slide-${i + 1}`]}
            />
          ))
        }
      </div>
      {
        screens.map((s, i) => (
          <p class:list={["fit-note absolute z-10 hidden rounded-full bg-white px-4 py-2 text-[13px] font-semibold whitespace-nowrap text-navy sm:block", `fit-note-${i + 1}`, s.notePos]} aria-hidden="true">
            {s.note}
          </p>
        ))
      }
    </div>
  </div>
  <h3 class="sr-only">Myna Fit</h3>
  <ol class="mt-10 flex flex-wrap justify-center gap-3">
    {
      screens.map((s, i) => (
        <li class:list={["fit-step relative", `fit-step-${i + 1}`]}>
          <button
            type="button"
            data-fit-step={i}
            aria-controls="fit-screen"
            aria-pressed={i === 0 ? "true" : "false"}
            class="fit-pill relative inline-flex min-h-12 cursor-pointer items-center overflow-hidden rounded-full px-6 text-[15px] font-semibold"
          >
            {s.title}
            <span class="fit-bar" aria-hidden="true" />
          </button>
        </li>
      ))
    }
  </ol>
  <div class="fit-caps relative mx-auto mt-6 max-w-[46ch] text-center">
    {screens.map((s, i) => <p class:list={["fit-cap text-[16px] leading-relaxed text-white/80", `fit-cap-${i + 1}`]}>{s.body}</p>)}
  </div>
  <p class="mt-8 text-center"><a href={mynaFitUrl} class="btn-light">Jadi Sehat Bareng</a></p>
</article>

<style>
  /* A plain device frame: the radius depicts hardware, so it sits outside the 6px UI radius. */
  .fit-phone {
    width: min(100%, 300px);
    padding: 9px;
    border-radius: 46px;
    background: #131c31;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14), 0 24px 60px rgb(0 0 0 / 0.35);
  }
  .fit-screen {
    position: relative;
    overflow: hidden;
    border-radius: 38px;
    aspect-ratio: 600 / 1032;
    background: #f8f6f3;
  }
  .fit-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .fit-slide-1 {
    opacity: 1;
  }
  .fit-note {
    opacity: 0;
    box-shadow: 0 1px 2px rgb(3 43 132 / 0.08), 0 8px 22px rgb(3 43 132 / 0.16);
  }
  .fit-note-1 {
    opacity: 1;
  }
  /* Pills on navy, like the guideline badge: outline when idle, white when open. */
  .fit-pill {
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.4);
    transition-property: background-color, color, box-shadow;
    transition-duration: 200ms;
  }
  .fit-pill[aria-pressed="true"] {
    background: #fff;
    color: var(--color-navy);
    box-shadow: none;
  }
  .fit-caps {
    display: grid;
  }
  .fit-cap {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .fit-cap-1 {
    opacity: 1;
  }
  .fit-bar {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: var(--color-electric);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* 12 s loop, 4 s per screen. Negative delays put screens 2 and 3 later in the same cycle. */
  /* Enhanced (JS): the script drives slides, captions and bars; the pill shows which is open. */
  @media (hover: hover) and (pointer: fine) {
    .fit-pill[aria-pressed="false"]:hover {
      box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.8);
    }
  }

  /* Without JS: the original CSS loop (12 s, 4 s per screen). */
  @media (prefers-reduced-motion: no-preference) {
    article:not([data-enhanced]) .fit-slide,
    article:not([data-enhanced]) .fit-note,
    article:not([data-enhanced]) .fit-cap,
    article:not([data-enhanced]) .fit-step,
    article:not([data-enhanced]) .fit-bar {
      animation-duration: 12s;
      animation-iteration-count: infinite;
      animation-timing-function: linear;
    }
    article:not([data-enhanced]) .fit-slide,
    article:not([data-enhanced]) .fit-note,
    article:not([data-enhanced]) .fit-cap {
      animation-name: fit-slide;
    }
    article:not([data-enhanced]) .fit-step {
      animation-name: fit-step;
    }
    article:not([data-enhanced]) .fit-bar {
      animation-name: fit-bar;
    }
    article:not([data-enhanced]) .fit-slide-2,
    article:not([data-enhanced]) .fit-note-2,
    article:not([data-enhanced]) .fit-cap-2,
    article:not([data-enhanced]) .fit-step-2,
    article:not([data-enhanced]) .fit-step-2 .fit-bar {
      animation-delay: -8s;
    }
    article:not([data-enhanced]) .fit-slide-3,
    article:not([data-enhanced]) .fit-note-3,
    article:not([data-enhanced]) .fit-cap-3,
    article:not([data-enhanced]) .fit-step-3,
    article:not([data-enhanced]) .fit-step-3 .fit-bar {
      animation-delay: -4s;
    }
  }
  @keyframes fit-slide {
    0%,
    30% {
      opacity: 1;
    }
    34%,
    96% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes fit-step {
    0%,
    31% {
      opacity: 1;
    }
    34%,
    97% {
      opacity: 0.5;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes fit-bar {
    0% {
      transform: scaleX(0);
    }
    33% {
      transform: scaleX(1);
    }
    33.4%,
    100% {
      transform: scaleX(0);
    }
  }
</style>

<script>
  import { animate, EASE, inView, motionOk } from "../scripts/motion";

  const root = document.querySelector<HTMLElement>("[data-fit]");
  if (root) {
    root.dataset.enhanced = "";
    const slides = [...root.querySelectorAll<HTMLElement>(".fit-slide")];
    const notes = [...root.querySelectorAll<HTMLElement>(".fit-note")];
    const caps = [...root.querySelectorAll<HTMLElement>(".fit-cap")];
    const steps = [...root.querySelectorAll<HTMLButtonElement>("[data-fit-step]")];
    const bars = steps.map((b) => b.parentElement?.querySelector<HTMLElement>(".fit-bar") ?? null);
    const moving = motionOk();
    const DWELL = 4; // seconds per screen
    let current = 0;
    let generation = 0;
    let onScreen = false;
    let held = false; // hover or keyboard focus inside the block
    let timer: ReturnType<typeof animate> | undefined;

    const sync = () => {
      if (!timer) return;
      if (onScreen && !held) timer.play();
      else timer.pause();
    };

    const runBar = () => {
      timer?.stop();
      timer = undefined;
      for (const bar of bars) if (bar) bar.style.transform = "scaleX(0)";
      const bar = bars[current];
      if (!moving || !bar) return;
      const mine = ++generation;
      timer = animate(bar, { transform: ["scaleX(0)", "scaleX(1)"] }, { duration: DWELL, ease: "linear" });
      timer.finished.then(() => {
        if (mine === generation) show((current + 1) % slides.length);
      });
      sync();
    };

    const show = (next: number) => {
      const prev = current;
      current = next;
      steps.forEach((b, i) => b.setAttribute("aria-pressed", i === next ? "true" : "false"));
      if (next !== prev) {
        for (const list of [slides, notes, caps]) {
          const from = list[prev];
          const to = list[next];
          if (!from || !to) continue;
          if (moving) {
            animate(from, { opacity: [1, 0] }, { duration: 0.35, ease: EASE });
            animate(to, { opacity: [0, 1] }, { duration: 0.35, ease: EASE });
          } else {
            from.style.opacity = "0";
            to.style.opacity = "1";
          }
        }
      }
      runBar();
    };

    steps.forEach((b, i) => b.addEventListener("click", () => show(i)));
    root.addEventListener("pointerenter", () => {
      held = true;
      sync();
    });
    // Keyboard focus holds the cycle; focus left behind by a mouse click does not.
    const keyboardFocusInside = () => root.contains(document.activeElement) && document.activeElement?.matches(":focus-visible") === true;
    root.addEventListener("pointerleave", () => {
      held = keyboardFocusInside();
      sync();
    });
    root.addEventListener("focusin", (e) => {
      if ((e.target as Element).matches(":focus-visible")) {
        held = true;
        sync();
      }
    });
    root.addEventListener("focusout", (e) => {
      const next = e.relatedTarget as Element | null;
      held = next !== null && root.contains(next) && next.matches(":focus-visible");
      sync();
    });
    inView(
      root,
      () => {
        onScreen = true;
        sync();
        return () => {
          onScreen = false;
          sync();
        };
      },
      { amount: 0.35 },
    );
    runBar();
  }
</script>

