---
import { formatIdr, mynaFitUrl, product } from "../lib/site";
import Icon from "./Icon.astro";
// Plans come straight from product.config.ts: changing prices needs no code edits.
const included = ["Akses Myna Fit: pelacak gym dan catatan kalori", "Akses Myna Food saat sudah tersedia", "Bayar sekali, tanpa perpanjangan otomatis"];
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    product.plans.map((plan) => (
      <article
        class:list={[
          "relative flex flex-col gap-4 rounded-2xl bg-card p-6 text-card-foreground shadow-sm transition-shadow duration-300 hover:shadow-lg md:p-8",
          plan.highlight ? "border-2 border-myna-blue dark:border-primary" : "border border-border",
        ]}
        data-plan={plan.id}
      >
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg font-semibold">Myna Health {plan.label}</h3>
          {plan.highlight && (
            <p class="rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground">Paling hemat</p>
          )}
        </div>
        <p class="text-4xl font-extrabold tracking-tight">{formatIdr(plan.priceIdr)}</p>
        <p class="text-sm text-muted-foreground">
          Sekitar {formatIdr(Math.round(plan.priceIdr / plan.months))} / bulan · dibayar sekali untuk {plan.months} bulan
        </p>
        <ul class="space-y-2.5">
          {included.map((item) => (
            <li class="flex items-start gap-3 text-[15px] text-foreground/80">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15">
                <Icon name="check" class="h-3.5 w-3.5 text-primary" />
              </span>
              {item}
            </li>
          ))}
        </ul>
        <a
          href={mynaFitUrl}
          data-event="checkout_started"
          data-plan={plan.id}
          class:list={[
            "mt-auto inline-flex h-12 items-center justify-center rounded-full px-6 text-center text-[15px] font-semibold transition-all duration-200 hover:scale-[1.02]",
            plan.highlight
              ? "bg-myna-blue text-white shadow-lg hover:bg-myna-blue-hover hover:shadow-xl"
              : "border-2 border-primary text-primary hover:bg-primary hover:text-primary-foreground",
          ]}
        >
          Mulai dengan Myna Fit
        </a>
      </article>
    ))
  }
</div>
<p class="mt-6 text-center text-sm text-muted-foreground">
  Harga dalam Rupiah. Pembayaran lewat QRIS, e-wallet (DANA, ShopeePay, OVO), atau virtual account bank.
  Lihat <a href="/refund/" class="text-primary underline underline-offset-4">Kebijakan Refund</a>.
</p>
