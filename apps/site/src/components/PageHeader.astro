---
// Inner-page header: left-aligned title on the page surface, closed by a hairline.
interface Props {
  label?: string;
  title: string;
  description?: string;
}
const { label, title, description } = Astro.props;
---

<section class="border-b border-border">
  <div class="container-myna pt-12 pb-10 md:pt-20 md:pb-14">
    {label && <p class="mb-4 text-[15px] font-medium text-muted-foreground">{label}</p>}
    <h1 class="max-w-[18ch] text-[36px] leading-[1.08] font-semibold tracking-[-0.025em] md:text-[52px]">{title}</h1>
    {description && <p class="lead mt-5 max-w-[56ch]">{description}</p>}
    <slot />
  </div>
</section>
