---
// Inner-page header: the navy gradient band, with the Lovable section typography.
interface Props {
  label?: string;
  title: string;
  description?: string;
}
const { label, title, description } = Astro.props;
---

<section class="navy-gradient relative isolate overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="orb orb-cta-a"></div>
    <div class="orb orb-cta-b"></div>
  </div>
  <div class="container-myna py-14 text-center md:py-20">
    {label && <p class="mb-3 text-xs font-semibold tracking-[0.15em] text-white/60 uppercase">{label}</p>}
    <h1 class="text-[32px] leading-[1.2] font-bold text-white md:text-[48px]">{title}</h1>
    {description && <p class="mx-auto mt-4 max-w-[600px] text-lg text-white/75">{description}</p>}
    <slot />
  </div>
</section>
