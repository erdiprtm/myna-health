---
// Inner-page header: soft-blue band, with the Lovable section typography.
interface Props {
  label?: string;
  title: string;
  description?: string;
}
const { label, title, description } = Astro.props;
---

<section class="border-b border-border bg-myna-soft/60">
  <div class="container-myna py-14 text-center md:py-20">
    {label && <p class="mb-3 text-xs font-semibold tracking-[0.15em] text-myna-navy/70 uppercase">{label}</p>}
    <h1 class="text-[32px] leading-[1.2] font-bold text-myna-navy md:text-[48px]">{title}</h1>
    {description && <p class="mx-auto mt-4 max-w-[600px] text-lg text-foreground/70">{description}</p>}
    <slot />
  </div>
</section>
