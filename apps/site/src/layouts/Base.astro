---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { analyticsClientId, company, disclaimer, mynaFitUrl, product } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Exact <title> (the home page); otherwise "<title> | Myna Health". */
  fullTitle?: string;
  /** Path of the OG image under /og/, e.g. "home" → /og/home.png */
  og?: string;
  jsonLd?: unknown[];
  /** Standard analytics event fired on load (Section 9), e.g. "pricing_view". */
  event?: "site_view" | "pricing_view";
  noindex?: boolean;
}

const { title, description, og = "home", jsonLd = [], event = "site_view", noindex = false } =
  Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${og}.png`, Astro.site);
const fullTitle = Astro.props.fullTitle ?? (title === product.name ? title : `${title} | ${product.name}`);
const year = new Date().getFullYear();

const links = [
  { href: "/tentang/", label: "Tentang Kami" },
  { href: "/#produk", label: "Produk" },
  { href: "/#perusahaan", label: "Perusahaan" },
];
const here = Astro.url.pathname;
const footerGroups = [
  {
    title: "Perusahaan",
    links: [
      { href: "/tentang/", label: "Tentang Kami" },
      { href: "/#perusahaan", label: "Informasi perusahaan" },
      { href: "/kontak/", label: "Kontak" },
    ],
  },
  {
    title: "Produk",
    links: [
      { href: mynaFitUrl, label: "Myna Fit" },
      { href: "/#myna-food", label: "Myna Food (segera hadir)" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/syarat/", label: "Syarat & Ketentuan" },
      { href: "/privasi/", label: "Kebijakan Privasi" },
      { href: "/refund/", label: "Kebijakan Refund" },
    ],
  },
];
---

<!doctype html>
<html lang={product.locale.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href={product.brand.favicon} type="image/svg+xml" />
    <meta name="theme-color" content="#f7f8fa" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={product.locale.default === "id" ? "id_ID" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    <!-- Light only, like the Lovable original (P-007): the site ignores the device's dark mode. -->
    <meta name="color-scheme" content="light" />
  </head>
  <body class="flex min-h-screen flex-col" data-page-event={event} data-op-client={analyticsClientId}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-card focus:p-2">Langsung ke konten</a>
    <!-- Floating pill navbar (P-016, Heva Health and Bevel): white pill over the page, never full-bleed. -->
    <header class="sticky top-0 z-50 px-3 pt-3 md:px-6 md:pt-4">
      <nav class="relative mx-auto flex h-14 max-w-[1200px] items-center justify-between rounded-full border border-navy/10 bg-white pr-2 pl-5 shadow-[0_1px_2px_rgb(3_43_132/0.05),0_8px_24px_rgb(3_43_132/0.08)] md:h-16 md:pr-2.5 md:pl-7" aria-label="Utama">
        <a href="/" class="flex items-center" aria-label={`${product.name}, ke beranda`}>
          <img src="/logo.png" alt={product.name} width="480" height="197" class="h-7 w-auto md:h-8" />
        </a>
        <div class="hidden items-center gap-8 md:flex">
          {
            links.map((l) => (
              <a
                href={l.href}
                class="text-[15px] text-muted-foreground transition-colors duration-150 hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:font-medium"
                aria-current={here === l.href ? "page" : undefined}
              >
                {l.label}
              </a>
            ))
          }
          <a href="/kontak/" class="btn-primary min-h-11 px-5 text-sm" aria-current={here.startsWith("/kontak/") ? "page" : undefined}>Hubungi kami</a>
        </div>
        <details class="mobile-menu md:hidden">
          <summary class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-foreground" aria-label="Menu">
            <Icon name="menu" class="menu-open h-6 w-6" />
            <Icon name="x" class="menu-close h-6 w-6" />
          </summary>
          <div class="absolute inset-x-0 top-[calc(100%+8px)] rounded-[28px] border border-navy/10 bg-white px-5 pb-5 shadow-[0_8px_24px_rgb(3_43_132/0.1)]">
            <div class="flex flex-col pt-1">
              {links.map((l) => <a href={l.href} class="border-b border-border py-3.5 text-base text-foreground">{l.label}</a>)}
              <a href="/kontak/" class="btn-primary mt-5 w-full">Hubungi kami</a>
            </div>
          </div>
        </details>
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="mt-auto border-t border-border bg-card">
      <div class="container-myna grid gap-12 py-14 md:grid-cols-12 md:py-16">
        <div class="md:col-span-5">
          <img src="/logo.png" alt={product.name} width="480" height="197" loading="lazy" class="h-9 w-auto" />
          <address class="mt-6 text-sm leading-relaxed text-muted-foreground not-italic" data-testid="company">
            <span class="font-medium text-foreground">{company.name}</span><br />
            {company.addressLines.join(", ")}<br />
            <a href={`mailto:${company.email}`} class="text-link font-normal">{company.email}</a>
          </address>
          <div class="mt-6"><SocialLinks /></div>
        </div>
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
          {
            footerGroups.map((g) => (
              <div>
                <h2 class="mb-3 text-sm font-semibold text-foreground">{g.title}</h2>
                <ul class="flex flex-col gap-2.5 text-sm">
                  {g.links.map((l) => (
                    <li><a href={l.href} class="text-muted-foreground transition-colors duration-150 hover:text-foreground">{l.label}</a></li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <div class="border-t border-border">
        <div class="container-myna flex flex-col gap-3 py-6 text-xs leading-relaxed text-muted-foreground md:flex-row md:justify-between md:gap-10">
          <p>&copy; {year} {company.name}. Myna Health adalah merek milik {company.name}.</p>
          <p class="max-w-md md:text-right" data-testid="disclaimer">{disclaimer}</p>
        </div>
      </div>
      <!-- Oversized wordmark bleeding off the bottom edge (P-016). Decorative: the logo above names the brand. -->
      <div class="overflow-hidden" aria-hidden="true">
        <p class="container-myna -mb-[0.2em] text-center text-[15.5vw] leading-[0.9] font-extrabold tracking-[-0.055em] whitespace-nowrap text-navy select-none xl:text-[188px]">myna health</p>
      </div>
    </footer>
    <script>
      // Standard events (Section 9) to OpenPanel. Bundled by Astro into a file (CSP: script-src 'self').
      // data-op-client is set only on production builds with a client ID; otherwise this is a no-op.
      import { createAnalytics, noopAnalytics, openPanelProvider, type StandardEvent } from "@factory/core/analytics";
      import { OpenPanel } from "@openpanel/web";

      const clientId = document.body.dataset.opClient;
      const analytics = createAnalytics(
        clientId ? openPanelProvider(new OpenPanel({ clientId, trackOutgoingLinks: true })) : noopAnalytics,
      );
      analytics.track((document.body.dataset.pageEvent ?? "site_view") as StandardEvent);
      for (const el of document.querySelectorAll("[data-event]")) {
        if (!(el instanceof HTMLElement)) continue;
        el.addEventListener("click", () =>
          analytics.track(
            (el.dataset.event ?? "") as StandardEvent,
            el.dataset.plan ? { plan: el.dataset.plan } : undefined,
          ),
        );
      }

      // Close the mobile menu after picking a link (same-page anchors).
      for (const a of document.querySelectorAll(".mobile-menu a")) {
        a.addEventListener("click", () => a.closest("details")?.removeAttribute("open"));
      }
    </script>
  </body>
</html>
