---
import CompanyIdentity from "../components/CompanyIdentity.astro";
import ContactAside from "../components/ContactAside.astro";
import Principles from "../components/Principles.astro";
import Base from "../layouts/Base.astro";
import { organizationLd } from "../lib/jsonld";
import { company, disclaimer, foundedYear, mynaFitUrl } from "../lib/site";

const site = Astro.site as URL;
// PRODUCT-OWNED copy (specs/myna-health.md, P-008, P-009). Corporate voice: calm, plain, "Anda".
// The company is the subject; products are its portfolio. No medical claims, no invented numbers.
---

<Base
  title="Myna Health"
  fullTitle="Myna Health — Aplikasi Gaya Hidup Sehat"
  description="Myna Health (PT Myna Bio Teknologi) membangun aplikasi wellness dan lifestyle: Myna Fit untuk pelacak kebugaran dan Myna Food untuk panduan makan sehat."
  jsonLd={[organizationLd(site)]}
>
  <!-- Hero: headline left, intro and one action right, then one wide photo. -->
  <section aria-labelledby="hero-title">
    <div class="container-myna pt-12 pb-16 md:pt-20 md:pb-24">
      <div class="grid gap-6 md:grid-cols-12 md:items-end md:gap-8">
        <h1 id="hero-title" class="h-display max-w-[13ch] text-foreground md:col-span-7">Membangun kebiasaan sehat untuk Indonesia.</h1>
        <div class="md:col-span-4 md:col-start-9 md:pb-2">
          <p class="lead max-w-[34ch]">{company.name} membuat aplikasi yang membantu orang lebih rutin berolahraga dan makan lebih teratur.</p>
          <a href="#produk" class="btn-primary mt-7">Lihat produk</a>
        </div>
      </div>
      <img
        src="/images/hero-pasangan-stretching.jpg"
        alt="Pasangan suami istri berbaju olahraga melakukan peregangan bersama di luar ruangan"
        width="1400"
        height="933"
        fetchpriority="high"
        class="mt-12 aspect-[4/3] w-full rounded-md object-cover sm:aspect-[16/9] md:mt-16 lg:aspect-[12/5] lg:object-[center_35%]"
      />
    </div>
  </section>

  <!-- Portfolio: the live product leads at a larger size; the upcoming one sits lower and smaller. -->
  <section id="produk" class="scroll-mt-20 border-t border-border py-16 md:py-24" aria-labelledby="products-title">
    <div class="container-myna">
      <div class="grid gap-4 md:grid-cols-12 md:gap-8">
        <h2 id="products-title" class="h-section md:col-span-5">Produk kami</h2>
        <p class="body-copy max-w-[48ch] md:col-span-6 md:col-start-7">
          Setiap produk berfokus pada satu kebiasaan, supaya mudah dijalani setiap hari tanpa perlu mengubah banyak hal sekaligus.
        </p>
      </div>
      <div class="mt-12 grid gap-14 md:mt-16 md:grid-cols-12 md:gap-8">
        <article id="myna-fit" class="scroll-mt-24 md:col-span-7">
          <img src="/images/fit-barbel.jpg" alt="Perempuan mengangkat barbel di gym yang terang" width="1400" height="933" loading="lazy" class="aspect-[3/2] w-full rounded-md object-cover" />
          <div class="mt-6 flex items-baseline justify-between gap-4 border-b border-border pb-4">
            <h3 class="text-2xl font-semibold tracking-[-0.015em]">Myna Fit</h3>
            <p class="text-sm text-muted-foreground">Tersedia di web</p>
          </div>
          <p class="body-copy mt-4 max-w-[52ch]">
            Pelacak latihan gym dan catatan kalori. Pengguna mencatat set, repetisi, beban, dan asupan harian, lalu melihat perkembangannya dari minggu ke minggu.
          </p>
          <p class="mt-5"><a href={mynaFitUrl} class="text-link">Buka Myna Fit</a> <span class="ml-2 text-sm text-muted-foreground">fit.mynahealth.id</span></p>
        </article>
        <article id="myna-food" class="scroll-mt-24 md:col-span-5 md:pt-24">
          <img src="/images/food-pasangan-dapur.jpg" alt="Pasangan menyiapkan sayur dan buah segar bersama di dapur" width="1400" height="933" loading="lazy" class="aspect-[4/3] w-full rounded-md object-cover" />
          <div class="mt-6 flex items-baseline justify-between gap-4 border-b border-border pb-4">
            <h3 class="text-2xl font-semibold tracking-[-0.015em]">Myna Food</h3>
            <p class="text-sm text-muted-foreground">Segera hadir</p>
          </div>
          <p class="body-copy mt-4">
            Panduan makan sesuai tujuan, seperti diet, tinggi protein, atau pola makan seimbang, dengan menu yang mudah ditemukan di Indonesia.
          </p>
          <p class="mt-5"><a href="/kontak/" class="text-link">Tanyakan jadwal peluncuran</a></p>
        </article>
      </div>
      <p class="mt-14 max-w-[70ch] text-sm text-muted-foreground">{disclaimer}</p>
    </div>
  </section>

  <!-- Company statement: set as reading text, not a banner. -->
  <section class="border-t border-border py-16 md:py-28" aria-labelledby="about-title">
    <div class="container-myna grid gap-6 md:grid-cols-12 md:gap-8">
      <h2 id="about-title" class="text-[15px] font-medium text-muted-foreground md:col-span-3 md:pt-3">Tentang kami</h2>
      <div class="md:col-span-9">
        <p class="font-serif text-[26px] leading-[1.35] tracking-[-0.01em] text-foreground md:text-[36px]">
          Kami percaya hidup sehat tumbuh dari kebiasaan kecil yang dijalani setiap hari. Tugas kami adalah membuat kebiasaan itu terasa mudah.
        </p>
        <p class="body-copy mt-8 max-w-[60ch]">
          {company.name} didirikan pada {foundedYear} di Kota Depok, Jawa Barat. Di bawah merek Myna Health, kami merancang, membangun, dan mengelola aplikasi untuk gaya hidup yang lebih sehat.
        </p>
        <p class="mt-6"><a href="/tentang/" class="text-link">Profil perusahaan</a></p>
      </div>
    </div>
  </section>

  <!-- Principles: a definition list, not a card grid. -->
  <section id="prinsip" class="scroll-mt-20 border-t border-border py-16 md:py-24" aria-labelledby="values-title">
    <div class="container-myna grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <h2 id="values-title" class="h-section">Cara kami bekerja</h2>
        <p class="body-copy mt-4 max-w-[32ch]">Pegangan kami saat membuat setiap keputusan produk.</p>
      </div>
      <div class="md:col-span-8"><Principles /></div>
    </div>
  </section>

  <!-- Company identity (entity KYC) with the contact route beside it. -->
  <section id="perusahaan" class="scroll-mt-20 border-t border-border bg-card py-16 md:py-24" aria-labelledby="identity-title">
    <div class="container-myna grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-8">
        <h2 id="identity-title" class="h-section">Informasi perusahaan</h2>
        <p class="body-copy mt-4 max-w-[52ch]">Myna Health adalah merek milik {company.name}. Berikut data badan usaha kami.</p>
        <div class="mt-10"><CompanyIdentity /></div>
      </div>
      <div class="md:col-span-4 md:col-start-9 md:pt-2"><ContactAside /></div>
    </div>
  </section>
</Base>
