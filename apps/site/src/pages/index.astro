---
import Capsules from "../components/Capsules.astro";
import CompanyIdentity from "../components/CompanyIdentity.astro";
import FitShowcase from "../components/FitShowcase.astro";
import Principles from "../components/Principles.astro";
import Base from "../layouts/Base.astro";
import { organizationLd } from "../lib/jsonld";
import { company, disclaimer, foundedYear } from "../lib/site";

const site = Astro.site as URL;
// PRODUCT-OWNED copy (specs/myna-health.md, P-008, P-009). Corporate voice: calm, plain, "Anda".
// The company is the subject; products are its portfolio. No medical claims, no invented numbers.
---

<Base
  title="Myna Health"
  fullTitle="Myna Health — Aplikasi Gaya Hidup Sehat"
  description="Myna Health (PT Myna Bio Teknologi) membangun aplikasi wellness dan lifestyle: Myna Fit untuk pelacak kebugaran dan Myna Food untuk panduan makan sehat."
  jsonLd={[organizationLd(site)]}
>
  <!-- Hero: the brand's navy cover with the capsule supergraphic (guideline 2026). The one bold moment. -->
  <section class="overflow-hidden bg-navy" aria-labelledby="hero-title">
    <div class="container-myna grid gap-12 pt-14 pb-16 md:grid-cols-12 md:items-center md:gap-10 md:pt-20 md:pb-24">
      <div class="md:col-span-6">
        <h1 id="hero-title" class="h-display max-w-[14ch] text-white">Membangun kebiasaan sehat <span class="text-cyan">untuk Indonesia.</span></h1>
        <p class="mt-6 max-w-[40ch] text-[18px] leading-[1.65] text-white/80 md:text-[20px]">Myna Health membuat aplikasi yang membantu Anda lebih rutin berolahraga dan makan lebih teratur.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#produk" class="btn-light">Lihat produk</a>
          <a href="/tentang/" class="btn-quiet-light">Tentang kami</a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-[300px] sm:max-w-[400px] md:col-span-6 md:max-w-[500px] md:justify-self-end">
        <Capsules />
      </div>
    </div>
  </section>

  <!-- Portfolio: Myna Fit shown through its own interface; Myna Food (no interface yet) with a photo. -->
  <section id="produk" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="products-title">
    <div class="container-myna">
      <div class="grid gap-4 md:grid-cols-12 md:gap-8">
        <h2 id="products-title" class="h-section md:col-span-5">Produk kami</h2>
        <p class="body-copy max-w-[48ch] md:col-span-6 md:col-start-7">
          Setiap produk fokus pada satu kebiasaan, sehingga mudah dijalani tanpa harus mengubah banyak hal sekaligus.
        </p>
      </div>
      <div class="mt-12 md:mt-16"><FitShowcase /></div>
      <article id="myna-food" class="mt-16 grid scroll-mt-24 gap-8 md:mt-24 md:grid-cols-12 md:items-center">
        <img src="/images/kapsul-pasangan-dapur.jpg" alt="Pasangan menyiapkan sayur dan buah segar bersama di dapur" width="900" height="600" loading="lazy" class="aspect-[4/3] w-full rounded-[28px] object-cover md:col-span-5" />
        <div class="md:col-span-6 md:col-start-7">
          <div class="flex items-baseline justify-between gap-4 border-b border-border pb-4">
            <h3 class="text-2xl font-semibold tracking-[-0.015em]">Myna Food</h3>
            <p class="rounded-full bg-badge px-3 py-1 text-xs font-semibold text-white">Segera hadir</p>
          </div>
          <p class="body-copy mt-5 max-w-[52ch]">
            Panduan makan sesuai tujuan, seperti diet, tinggi protein, atau pola makan seimbang, dengan menu yang mudah ditemukan di Indonesia.
          </p>
          <p class="mt-6"><a href="/kontak/" class="text-link">Tanyakan jadwal peluncuran</a></p>
        </div>
      </article>
      <p class="mt-16 max-w-[70ch] text-sm text-muted-foreground">{disclaimer}</p>
    </div>
  </section>

  <!-- Company statement: set as reading text, not a banner. -->
  <section class="bg-soft py-16 md:py-28" aria-labelledby="about-title">
    <div class="container-myna grid gap-6 md:grid-cols-12 md:gap-8">
      <h2 id="about-title" class="text-[15px] font-semibold text-navy/70 md:col-span-3 md:pt-3">Tentang kami</h2>
      <div class="md:col-span-9">
        <p class="text-[24px] leading-[1.4] font-bold tracking-[-0.02em] text-navy md:text-[34px]">
          Kami percaya hidup sehat tumbuh dari kebiasaan kecil yang dijalani setiap hari. Tugas kami adalah membuat kebiasaan itu terasa mudah.
        </p>
        <p class="body-copy mt-8 max-w-[60ch]">
          {company.name} didirikan pada {foundedYear}. Di bawah merek Myna Health, kami merancang, membangun, dan mengelola aplikasi untuk gaya hidup yang lebih sehat.
        </p>
        <p class="mt-6"><a href="/tentang/" class="text-link">Profil perusahaan</a></p>
      </div>
    </div>
  </section>

  <!-- Principles: a definition list, not a card grid. -->
  <section id="prinsip" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="values-title">
    <div class="container-myna grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <h2 id="values-title" class="h-section">Cara kami bekerja</h2>
        <p class="body-copy mt-4 max-w-[32ch]">Pegangan kami saat membuat setiap keputusan produk.</p>
      </div>
      <div class="md:col-span-8"><Principles /></div>
    </div>
  </section>

  <!-- Company identity (entity KYC) with the contact route beside it. -->
  <section id="perusahaan" class="scroll-mt-20 border-t border-border bg-card py-16 md:py-24" aria-labelledby="identity-title">
    <div class="container-myna grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-10">
        <h2 id="identity-title" class="h-section">Informasi perusahaan</h2>
        <p class="body-copy mt-4 max-w-[52ch]">Myna Health adalah merek milik {company.name}. Berikut data badan usaha kami.</p>
        <div class="mt-10"><CompanyIdentity /></div>
      </div>
    </div>
  </section>

  <!-- Closing panel: navy with a small capsule cluster, like the guideline's closing slide. -->
  <section class="py-16 md:py-24" aria-labelledby="cta-title">
    <div class="container-myna">
      <div class="grid items-center gap-10 overflow-hidden rounded-[36px] bg-navy px-8 py-12 md:grid-cols-12 md:px-14 md:py-16">
        <div class="md:col-span-7">
          <h2 id="cta-title" class="text-[32px] leading-[1.1] font-extrabold tracking-[-0.025em] text-white md:text-[44px]">Mari terhubung.</h2>
          <p class="mt-4 max-w-[44ch] text-[17px] leading-[1.65] text-white/80">Untuk pertanyaan, kemitraan, atau informasi perusahaan, silakan hubungi kami.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/kontak/" class="btn-light">Kirim pesan</a>
            <a href={`mailto:${company.email}`} class="btn-quiet-light">{company.email}</a>
          </div>
        </div>
        <div class="hidden justify-self-end md:col-span-5 md:flex md:items-center"><Capsules variant="cta" /></div>
      </div>
    </div>
  </section>
</Base>
