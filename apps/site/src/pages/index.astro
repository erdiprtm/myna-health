---
import CompanyIdentity from "../components/CompanyIdentity.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { faqLd, organizationLd } from "../lib/jsonld";
import { company, disclaimer, mynaFitUrl, values } from "../lib/site";

const site = Astro.site as URL;
// PRODUCT-OWNED copy (specs/myna-health.md, P-007). Voice: a friend at the gym who is a bit nerdy
// about food. Short lines, "kamu", no shaming, no medical claims, no invented numbers.
const tags = ["gym tracker", "catatan kalori", "ide menu high-protein", "makan seimbang", "privasi terjaga", "dari Depok"];
const intro = [
  {
    label: "Siapa kami",
    title: "Perusahaan teknologi dari Depok.",
    body: "Fokus kami satu: bikin kebiasaan sehat terasa gampang dijalani, bukan jadi beban tambahan.",
  },
  {
    label: "Apa yang kami buat",
    title: "Aplikasi untuk urusan sehari-hari.",
    body: "Catat latihan, catat makan, cari ide menu. Hal kecil yang kalau rutin, kerasa bedanya.",
  },
  {
    label: "Cara kami kerja",
    title: "Simpel dulu, baru tambah fitur.",
    body: "Yang nggak kepakai kami buang. Yang kamu catat, kami jaga.",
  },
];
const manifesto = [
  { text: "Sehat itu nggak harus ribet.", tone: "big" },
  { text: "Nggak ada badan yang salah.", tone: "accent" },
  { text: "Skip gym sehari? Besok lagi.", tone: "big" },
  { text: "Nasi boleh. Tempe goreng juga boleh.", tone: "small" },
  { text: "Satu set tetap lebih banyak dari nol.", tone: "big" },
  { text: "Catat dulu, mikirnya belakangan.", tone: "accent" },
  { text: "Progress kamu, ukurannya kamu sendiri.", tone: "small" },
  { text: "Pelan-pelan, yang penting jalan.", tone: "close" },
] as const;
const privacy = [
  "Yang kami simpan cuma data akun dan catatan yang kamu isi sendiri.",
  "Data kamu nggak dijual ke siapa pun.",
  "Kamu bisa minta salinan atau penghapusan data kapan saja.",
  "Diproses sesuai UU Pelindungan Data Pribadi.",
];
---

<Base
  title="Myna Health"
  fullTitle="Myna Health — Aplikasi Gaya Hidup Sehat"
  description="Myna Health (PT Myna Bio Teknologi) membangun aplikasi wellness dan lifestyle: Myna Fit untuk pelacak kebugaran dan Myna Food untuk panduan makan sehat."
  jsonLd={[organizationLd(site), faqLd()]}
>
  <!-- 1. Hero: big-type statement on the light background, photo with product chips. -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div class="container-myna grid items-center gap-12 pt-10 pb-16 md:pt-16 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:pb-24">
      <div>
        <h1 id="hero-title" class="text-[52px] leading-[0.95] font-extrabold tracking-tight text-foreground sm:text-[72px] lg:text-[88px]">
          Sehat<br />versi <span class="text-primary">kamu.</span>
        </h1>
        <p class="mt-6 max-w-[520px] text-lg leading-relaxed text-muted-foreground md:text-xl">
          Myna Health bikin aplikasi yang bantu kamu lebih rajin gerak dan makan lebih teratur. Tanpa drama, tanpa ceramah.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#produk" class="inline-flex h-12 items-center gap-2 rounded-full bg-primary px-7 text-[15px] font-semibold text-primary-foreground shadow-lg transition-all duration-200 hover:scale-[1.02] hover:shadow-xl">
            Lihat produk <Icon name="arrow-right" />
          </a>
          <a href="/kontak/" class="inline-flex h-12 items-center rounded-full border-2 border-primary px-7 text-[15px] font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground">
            Hubungi kami
          </a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="absolute -inset-3 -z-10 rotate-3 rounded-[2rem] bg-myna-soft"></div>
        <div class="aspect-[4/5] overflow-hidden rounded-3xl shadow-xl">
          <img src="/images/hero-stretching.jpg" alt="Perempuan berhijab berbaju olahraga merah muda melakukan peregangan di luar ruangan" width="1400" height="1750" class="h-full w-full object-cover" fetchpriority="high" />
        </div>
        <a href={mynaFitUrl} class="absolute top-6 -left-4 flex items-center gap-3 rounded-2xl border border-border/60 bg-card px-4 py-3 shadow-lg transition-transform hover:scale-[1.03] sm:-left-8">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent text-primary"><Icon name="dumbbell" /></span>
          <span class="text-left">
            <span class="block text-sm font-semibold text-foreground">Myna Fit</span>
            <span class="block text-xs text-muted-foreground">Tersedia sekarang</span>
          </span>
        </a>
        <a href="#myna-food" class="absolute -right-3 bottom-8 flex items-center gap-3 rounded-2xl border border-border/60 bg-card px-4 py-3 shadow-lg transition-transform hover:scale-[1.03] sm:-right-6">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-food-soft text-food"><Icon name="utensils" /></span>
          <span class="text-left">
            <span class="block text-sm font-semibold text-foreground">Myna Food</span>
            <span class="block text-xs text-muted-foreground">Segera hadir</span>
          </span>
        </a>
      </div>
    </div>
    <div class="w-full overflow-hidden border-y border-border bg-myna-band py-4">
      <ul class="marquee-track flex w-max animate-marquee gap-10 will-change-transform">
        {
          [0, 1, 2].map((copy) =>
            tags.map((t) => (
              <li class="inline-flex items-center gap-10 text-[15px] font-medium whitespace-nowrap text-foreground/70" aria-hidden={copy > 0 ? "true" : undefined}>
                {t}
                <span class="text-primary" aria-hidden="true">✦</span>
              </li>
            )),
          )
        }
      </ul>
    </div>
  </section>

  <!-- 2. Who / What / How. -->
  <section class="section-padding" aria-labelledby="intro-title">
    <div class="container-myna">
      <h2 id="intro-title" class="sr-only">Tentang Myna Health</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {
          intro.map((b, i) => (
            <div class="rounded-2xl border border-border bg-card p-7" data-reveal>
              <p class="mb-5 font-mono text-[12px] font-medium tracking-[0.1em] text-muted-foreground uppercase">
                0{i + 1} · {b.label}
              </p>
              <h3 class="mb-3 text-2xl leading-tight font-semibold text-foreground">{b.title}</h3>
              <p class="card-desc">{b.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Products as a bento grid. -->
  <section id="produk" class="section-padding scroll-mt-20 pt-0 md:pt-0" aria-labelledby="products-title">
    <div class="container-myna">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-label mb-3">Produk</p>
          <h2 id="products-title" class="section-headline">Satu kebiasaan,<br /><span class="text-primary">satu aplikasi.</span></h2>
        </div>
        <p class="section-desc max-w-sm">Tiap produk Myna fokus ke satu hal, biar gampang dipakai tiap hari.</p>
      </div>
      <div class="grid gap-6 lg:grid-cols-5">
        <article id="myna-fit" class="group relative flex scroll-mt-24 flex-col overflow-hidden rounded-3xl border border-border bg-card lg:col-span-3 lg:flex-row">
          <div class="flex flex-1 flex-col p-7 md:p-9">
            <span class="mb-5 w-fit rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground">Tersedia</span>
            <h3 class="mb-3 text-[32px] leading-tight font-bold text-foreground">Myna Fit</h3>
            <p class="card-desc mb-6">Gym tracker dan catatan kalori dalam satu aplikasi. Catat set, rep, dan beban, catat makanmu, lalu lihat progresnya minggu ke minggu.</p>
            <ul class="mb-8 space-y-2.5">
              {
                ["Rencana latihan sesuai goal kamu", "Riwayat latihan dan kalori harian", "Langsung dari browser, tanpa install"].map((f) => (
                  <li class="flex items-start gap-3 text-[15px] text-foreground/80">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15">
                      <Icon name="check" class="h-3.5 w-3.5 text-primary" />
                    </span>
                    {f}
                  </li>
                ))
              }
            </ul>
            <a href={mynaFitUrl} class="mt-auto inline-flex h-12 w-fit items-center gap-2 rounded-full bg-primary px-7 text-[15px] font-semibold text-primary-foreground shadow-lg transition-all hover:scale-[1.02] hover:shadow-xl">
              Buka Myna Fit <Icon name="arrow-right" />
            </a>
          </div>
          <div class="aspect-[4/3] overflow-hidden lg:aspect-auto lg:w-[42%]">
            <img src="/images/fit-barbel.jpg" alt="Perempuan mengangkat barbel di gym yang terang" width="1400" height="933" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
          </div>
        </article>
        <div class="grid gap-6 lg:col-span-2">
          <article id="myna-food" class="group relative flex scroll-mt-24 flex-col overflow-hidden rounded-3xl bg-food-soft">
            <div class="aspect-[16/9] overflow-hidden">
              <img src="/images/food-urap.jpg" alt="Sepiring urap sayur dengan kelapa parut" width="1400" height="2487" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
            </div>
            <div class="flex flex-1 flex-col p-7">
              <span class="mb-4 w-fit rounded-full bg-food px-3 py-1 text-xs font-semibold text-white">Segera hadir</span>
              <h3 class="mb-2 text-2xl font-bold text-foreground">Myna Food</h3>
              <p class="card-desc mb-5">Lagi diet, butuh high-protein, atau cuma mau makan lebih seimbang? Myna Food bantu pilih menunya.</p>
              <a href="/kontak/" class="mt-auto inline-flex w-fit items-center gap-2 text-[15px] font-semibold text-food-deep underline underline-offset-4 hover:opacity-70">Kabari saya pas rilis <Icon name="arrow-right" /></a>
            </div>
          </article>
          <div class="flex items-center gap-4 rounded-3xl border border-dashed border-border bg-card/60 p-6">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-accent text-primary"><Icon name="sparkles" /></span>
            <p class="text-[15px] leading-snug text-muted-foreground"><span class="font-semibold text-foreground">Produk berikutnya</span> lagi kami siapin.</p>
          </div>
        </div>
      </div>
      <p class="mt-6 text-center text-xs text-muted-foreground">{disclaimer}</p>
    </div>
  </section>

  <!-- 4. Values. -->
  <section id="nilai" class="section-padding pt-0 md:pt-0" aria-labelledby="values-title">
    <div class="container-myna">
      <div class="mb-10 max-w-2xl">
        <p class="section-label mb-3">Yang kami pegang</p>
        <h2 id="values-title" class="section-headline">Empat hal yang <span class="text-primary">nggak bisa ditawar.</span></h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v) => (
            <div class="rounded-2xl border border-border bg-card p-6 transition-shadow duration-300 hover:shadow-lg" data-reveal>
              <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent text-primary">
                <Icon name={v.icon} class="h-5 w-5" />
              </span>
              <h3 class="card-title mb-2">{v.title}</h3>
              <p class="card-desc">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. Manifesto: one line per beat, big type, revealed while scrolling. The one navy moment. -->
  <section id="manifesto" class="bg-myna-navy" aria-labelledby="manifesto-title">
    <div class="container-myna py-20 md:py-28">
      <p id="manifesto-title" class="mb-10 text-xs font-semibold tracking-[0.15em] text-white/60 uppercase">Manifesto Myna</p>
      <ul class="space-y-4 md:space-y-6">
        {
          manifesto.map((m) => (
            <li
              data-reveal
              class:list={[
                "leading-[1.05] font-extrabold tracking-tight",
                m.tone === "big" && "text-[34px] text-white md:text-[64px]",
                m.tone === "accent" && "text-[34px] text-myna-cyan md:text-[64px]",
                m.tone === "small" && "text-xl font-semibold text-white/70 md:text-3xl",
                m.tone === "close" && "pt-6 text-[40px] text-white md:pt-10 md:text-[80px]",
              ]}
            >
              {m.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6. Privacy commitment (stands in for stats we don't have). -->
  <section id="privasi" class="section-padding" aria-labelledby="privacy-title">
    <div class="container-myna">
      <div class="grid items-center gap-10 overflow-hidden rounded-3xl border border-border bg-card p-8 md:p-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
        <div>
          <span class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-accent text-primary"><Icon name="shield-check" class="h-6 w-6" /></span>
          <h2 id="privacy-title" class="section-headline mb-4">Data kamu,<br /><span class="text-primary">kendali kamu.</span></h2>
          <a href="/privasi/" class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary underline underline-offset-4">Baca Kebijakan Privasi <Icon name="arrow-right" /></a>
        </div>
        <ul class="space-y-4">
          {
            privacy.map((p) => (
              <li class="flex items-start gap-3 rounded-2xl bg-secondary/60 p-4 text-[15px] leading-snug text-foreground/80">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15">
                  <Icon name="check" class="h-3.5 w-3.5 text-primary" />
                </span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 7. Company identity (entity KYC). -->
  <section id="perusahaan" class="section-padding scroll-mt-20 pt-0 md:pt-0" aria-labelledby="identity-title">
    <div class="container-myna grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div>
        <p class="section-label mb-3">Perusahaan</p>
        <h2 id="identity-title" class="section-headline mb-4">Siapa di balik <span class="text-primary">Myna Health.</span></h2>
        <p class="section-desc leading-relaxed">Myna Health adalah merek milik {company.name}. Semua yang perlu kamu tahu soal kami, ada di sini.</p>
      </div>
      <CompanyIdentity />
    </div>
  </section>

  <!-- 8. FAQ. -->
  <section id="faq" class="section-padding pt-0 md:pt-0" aria-labelledby="faq-title">
    <div class="container-myna max-w-3xl">
      <div class="mb-10 text-center">
        <p class="section-label mb-3">FAQ</p>
        <h2 id="faq-title" class="section-headline">Yang sering ditanya</h2>
      </div>
      <Faq />
    </div>
  </section>

  <!-- 9. Final CTA: rounded panel with a photo. -->
  <section class="section-padding pt-0 md:pt-0" aria-labelledby="cta-title">
    <div class="container-myna">
      <div class="relative flex min-h-[380px] flex-col overflow-hidden rounded-3xl bg-primary md:flex-row">
        <div class="relative z-10 flex flex-col justify-center px-8 py-10 md:w-[55%] md:px-14 md:py-16 lg:w-1/2 lg:px-20">
          <h2 id="cta-title" class="mb-4 text-3xl leading-tight font-extrabold text-white md:text-4xl lg:text-[44px]">Ada pertanyaan? Mau kerja sama?</h2>
          <p class="mb-8 max-w-md text-base leading-relaxed text-white/80 md:text-lg">Kirim pesan aja. Kami balas di hari kerja.</p>
          <a href="/kontak/" class="inline-flex h-14 w-fit items-center justify-center gap-2 rounded-full bg-white px-10 text-base font-semibold text-primary shadow-lg transition-all duration-200 hover:scale-[1.02] hover:shadow-xl">
            Hubungi kami <Icon name="arrow-right" class="ml-1 h-5 w-5" />
          </a>
          <a href={`mailto:${company.email}`} class="mt-5 inline-flex w-fit items-center gap-2 text-sm text-white/70 transition-colors hover:text-white">
            <Icon name="mail" /> {company.email}
          </a>
        </div>
        <div class="relative h-[260px] md:absolute md:top-0 md:right-0 md:bottom-0 md:h-auto md:w-1/2 lg:w-[55%]">
          <img src="/images/cta-lari-pagi.jpg" alt="" width="1400" height="2100" loading="lazy" class="h-full w-full object-cover object-center" />
          <div class="absolute inset-0 bg-gradient-to-b from-primary to-transparent md:bg-gradient-to-r"></div>
        </div>
      </div>
    </div>
  </section>
</Base>
