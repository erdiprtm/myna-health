---
import CompanyIdentity from "../components/CompanyIdentity.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { organizationLd } from "../lib/jsonld";
import { company, disclaimer, foundedYear, mynaFitUrl, values } from "../lib/site";

const site = Astro.site as URL;
// PRODUCT-OWNED copy (specs/myna-health.md, P-008). Corporate voice: calm, confident, warm, "Anda".
// The company is the subject; products are its portfolio. No medical claims, no invented numbers.
const headline = [
  { w: "Membangun" },
  { w: "kebiasaan", accent: true },
  { w: "sehat", accent: true },
  { w: "untuk" },
  { w: "Indonesia." },
];
const facts = [
  { value: String(foundedYear), label: "Tahun berdiri" },
  { value: "2", label: "Produk dalam portofolio" },
  { value: "Depok", label: "Kantor pusat, Jawa Barat" },
];
const statement =
  "Kami percaya hidup sehat tumbuh dari kebiasaan kecil yang dijalani setiap hari. Tugas kami adalah membuat kebiasaan itu terasa mudah.";
const privacy = [
  "Kami hanya menyimpan data akun dan catatan yang diisi sendiri oleh pengguna.",
  "Data pengguna tidak diperjualbelikan kepada pihak mana pun.",
  "Pengguna dapat meminta salinan atau penghapusan data kapan saja.",
  "Pemrosesan data mengikuti UU Pelindungan Data Pribadi.",
];
---

<Base
  title="Myna Health"
  fullTitle="Myna Health — Aplikasi Gaya Hidup Sehat"
  description="Myna Health (PT Myna Bio Teknologi) membangun aplikasi wellness dan lifestyle: Myna Fit untuk pelacak kebugaran dan Myna Food untuk panduan makan sehat."
  jsonLd={[organizationLd(site)]}
>
  <!-- 1. Hero: word-by-word headline, revealed photo, slow gradient orbs. -->
  <section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="orb orb-a"></div>
      <div class="orb orb-b"></div>
      <div class="orb orb-c"></div>
    </div>
    <div class="container-myna grid items-center gap-14 pt-12 pb-20 md:pt-20 lg:grid-cols-[1.15fr_1fr] lg:gap-20 lg:pb-28">
      <div>
        <h1 id="hero-title" class="text-[44px] leading-[1.02] font-bold tracking-[-0.03em] text-foreground sm:text-[60px] lg:text-[76px]">
          {
            headline.map((h, i) => (
              <>
                <span class:list={["hero-word", `d-${i + 1}`, h.accent && "text-primary"]}>{h.w}</span>{" "}
              </>
            ))
          }
        </h1>
        <p class="hero-fade d-6 mt-7 max-w-[540px] text-lg leading-relaxed text-muted-foreground md:text-xl">
          Myna Health mengembangkan produk digital wellness dan lifestyle yang membantu orang menjalani hidup lebih aktif dan makan lebih teratur.
        </p>
        <div class="hero-fade d-7 mt-9 flex flex-wrap gap-3">
          <a href="/tentang/" class="btn-shine inline-flex h-12 items-center gap-2 rounded-full bg-primary px-7 text-[15px] font-semibold text-primary-foreground shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl">
            Kenali kami <Icon name="arrow-right" />
          </a>
          <a href="#produk" class="inline-flex h-12 items-center rounded-full border border-foreground/15 bg-card/70 px-7 text-[15px] font-semibold text-foreground backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:border-primary hover:text-primary">
            Produk kami
          </a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="hero-media aspect-[4/5] overflow-hidden rounded-[2rem] shadow-2xl shadow-myna-navy/10">
          <img src="/images/hero-stretching.jpg" alt="Perempuan berhijab berbaju olahraga merah muda melakukan peregangan di luar ruangan" width="1400" height="1750" class="h-[112%] w-full object-cover" data-parallax fetchpriority="high" />
        </div>
        <div class="hero-fade d-8 absolute -bottom-6 -left-4 rounded-2xl border border-border/70 bg-card/90 px-5 py-4 shadow-xl backdrop-blur sm:-left-10">
          <p class="text-xs font-semibold tracking-[0.15em] text-muted-foreground uppercase">Sejak {foundedYear}</p>
          <p class="mt-1 text-sm font-semibold text-foreground">{company.name}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Facts: honest numbers only, with a drawn rule. -->
  <section aria-label="Sekilas perusahaan">
    <div class="container-myna grid gap-8 pb-20 sm:grid-cols-3 md:pb-28">
      {
        facts.map((f, i) => (
          <div class:list={["fact", `d-${i + 1}`]} data-reveal>
            <span class="fact-rule" aria-hidden="true"></span>
            <p class="pt-6 text-[44px] leading-none font-bold tracking-[-0.03em] text-foreground md:text-[56px]">{f.value}</p>
            <p class="mt-3 text-sm text-muted-foreground">{f.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3. About. -->
  <section class="section-padding border-t border-border bg-card" aria-labelledby="about-title">
    <div class="container-myna grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <div data-reveal>
        <p class="section-label mb-4">Tentang kami</p>
        <h2 id="about-title" class="text-[32px] leading-[1.15] font-bold tracking-[-0.02em] text-foreground md:text-[44px]">Perusahaan teknologi wellness dan lifestyle.</h2>
      </div>
      <div class="space-y-5 text-[17px] leading-relaxed text-foreground/75" data-reveal>
        <p>
          {company.name} didirikan pada {foundedYear} di Kota Depok, Jawa Barat. Di bawah merek Myna Health, kami merancang, membangun, dan mengelola produk digital yang mendukung gaya hidup lebih sehat.
        </p>
        <p>Setiap produk kami berfokus pada satu kebiasaan, mulai dari berolahraga hingga memilih makanan, agar mudah dijalani secara konsisten.</p>
        <a href="/tentang/" class="link-underline inline-flex items-center gap-2 pt-2 text-[15px] font-semibold text-primary">Profil perusahaan <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- 4. Portfolio. -->
  <section id="produk" class="section-padding scroll-mt-20" aria-labelledby="products-title">
    <div class="container-myna">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="section-label mb-4">Portofolio</p>
          <h2 id="products-title" class="text-[32px] leading-[1.15] font-bold tracking-[-0.02em] text-foreground md:text-[44px]">Produk kami</h2>
        </div>
        <p class="max-w-sm text-[15px] leading-relaxed text-muted-foreground">Dua produk dengan satu tujuan: membuat kebiasaan sehat lebih mudah dijalani.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <a id="myna-fit" href={mynaFitUrl} class="product-card group scroll-mt-24" data-reveal>
          <div class="aspect-[16/10] overflow-hidden">
            <img src="/images/fit-barbel.jpg" alt="Perempuan mengangkat barbel di gym yang terang" width="1400" height="933" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.05]" />
          </div>
          <div class="flex flex-1 flex-col p-7 md:p-9">
            <div class="mb-4 flex items-center justify-between gap-3">
              <h3 class="text-[28px] font-bold tracking-[-0.02em] text-foreground">Myna Fit</h3>
              <span class="rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground">Tersedia</span>
            </div>
            <p class="card-desc mb-8">Pelacak latihan gym dan catatan kalori. Pengguna dapat mencatat set, repetisi, beban, dan asupan harian, lalu memantau progresnya dari waktu ke waktu.</p>
            <span class="mt-auto inline-flex items-center gap-2 text-[15px] font-semibold text-primary">
              fit.mynahealth.id <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </div>
        </a>
        <a id="myna-food" href="/kontak/" class="product-card group scroll-mt-24" data-reveal>
          <div class="aspect-[16/10] overflow-hidden">
            <img src="/images/food-urap.jpg" alt="Sepiring urap sayur dengan kelapa parut" width="1400" height="2487" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.05]" />
          </div>
          <div class="flex flex-1 flex-col p-7 md:p-9">
            <div class="mb-4 flex items-center justify-between gap-3">
              <h3 class="text-[28px] font-bold tracking-[-0.02em] text-foreground">Myna Food</h3>
              <span class="rounded-full bg-food-soft px-3 py-1 text-xs font-semibold text-food-deep">Segera hadir</span>
            </div>
            <p class="card-desc mb-8">Panduan makan sesuai tujuan, seperti diet, tinggi protein, atau pola makan seimbang, dengan pilihan menu yang mudah ditemukan di Indonesia.</p>
            <span class="mt-auto inline-flex items-center gap-2 text-[15px] font-semibold text-food-deep">
              Info peluncuran <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </div>
        </a>
      </div>
      <p class="mt-8 text-center text-xs text-muted-foreground">{disclaimer}</p>
    </div>
  </section>

  <!-- 5. Statement: words fill in while scrolling. -->
  <section class="border-y border-border bg-card" aria-label="Pernyataan perusahaan">
    <div class="container-myna py-24 md:py-36">
      <p class="mx-auto max-w-5xl text-center text-[30px] leading-[1.25] font-semibold tracking-[-0.02em] text-foreground md:text-[52px]" data-fill>
        {statement.split(" ").map((w) => <span class="fill-word">{w} </span>)}
      </p>
    </div>
  </section>

  <!-- 6. Principles: sticky heading, numbered editorial list. -->
  <section id="prinsip" class="section-padding" aria-labelledby="values-title">
    <div class="container-myna grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start" data-reveal>
        <p class="section-label mb-4">Prinsip kami</p>
        <h2 id="values-title" class="text-[32px] leading-[1.15] font-bold tracking-[-0.02em] text-foreground md:text-[44px]">Cara kami membangun produk.</h2>
        <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-muted-foreground">Empat prinsip yang menjadi pegangan di setiap keputusan produk.</p>
      </div>
      <ol class="divide-y divide-border border-y border-border">
        {
          values.map((v, i) => (
            <li class="principle group grid grid-cols-[56px_1fr] gap-4 py-8 md:grid-cols-[80px_1fr]" data-reveal>
              <span class="font-mono text-sm text-muted-foreground transition-colors group-hover:text-primary">0{i + 1}</span>
              <div>
                <h3 class="mb-2 text-xl font-semibold text-foreground md:text-2xl">{v.title}</h3>
                <p class="card-desc max-w-lg">{v.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 7. Privacy commitment. -->
  <section id="privasi" class="section-padding pt-0 md:pt-0" aria-labelledby="privacy-title">
    <div class="container-myna">
      <div class="grid items-center gap-10 rounded-[2rem] bg-myna-soft/50 p-8 md:p-14 lg:grid-cols-[1fr_1.2fr] lg:gap-16" data-reveal>
        <div>
          <span class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-card text-primary shadow-sm"><Icon name="shield-check" class="h-6 w-6" /></span>
          <h2 id="privacy-title" class="text-[32px] leading-[1.15] font-bold tracking-[-0.02em] text-foreground md:text-[44px]">Privasi sebagai prinsip.</h2>
          <a href="/privasi/" class="link-underline mt-5 inline-flex items-center gap-2 text-[15px] font-semibold text-primary">Kebijakan Privasi <Icon name="arrow-right" /></a>
        </div>
        <ul class="space-y-3">
          {
            privacy.map((p) => (
              <li class="flex items-start gap-3 rounded-2xl bg-card p-4 text-[15px] leading-snug text-foreground/80 shadow-sm">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15">
                  <Icon name="check" class="h-3.5 w-3.5 text-primary" />
                </span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 8. Company identity (entity KYC). -->
  <section id="perusahaan" class="section-padding scroll-mt-20 pt-0 md:pt-0" aria-labelledby="identity-title">
    <div class="container-myna grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div data-reveal>
        <p class="section-label mb-4">Perusahaan</p>
        <h2 id="identity-title" class="text-[32px] leading-[1.15] font-bold tracking-[-0.02em] text-foreground md:text-[44px]">Identitas perusahaan</h2>
        <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-muted-foreground">Myna Health adalah merek milik {company.name}.</p>
      </div>
      <div data-reveal><CompanyIdentity /></div>
    </div>
  </section>

  <!-- 9. Closing CTA. -->
  <section class="section-padding pt-0 md:pt-0" aria-labelledby="cta-title">
    <div class="container-myna">
      <div class="relative isolate overflow-hidden rounded-[2rem] bg-myna-navy px-8 py-16 text-center md:px-16 md:py-24" data-reveal>
        <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
          <div class="orb orb-cta-a"></div>
          <div class="orb orb-cta-b"></div>
        </div>
        <h2 id="cta-title" class="mx-auto max-w-2xl text-[32px] leading-[1.15] font-bold tracking-[-0.02em] text-white md:text-[48px]">Mari terhubung.</h2>
        <p class="mx-auto mt-5 max-w-lg text-base leading-relaxed text-white/75 md:text-lg">Untuk pertanyaan, kemitraan, atau informasi perusahaan, silakan hubungi kami.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/kontak/" class="inline-flex items-center gap-2 rounded-full bg-white px-8 py-3.5 text-[15px] font-semibold text-myna-navy shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl">
            Hubungi kami <Icon name="arrow-right" />
          </a>
          <a href={`mailto:${company.email}`} class="inline-flex items-center gap-2 rounded-full border border-white/25 px-8 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-white/10">
            <Icon name="mail" /> {company.email}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
