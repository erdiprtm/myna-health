---
import Promises from "../components/Promises.astro";
import Base from "../layouts/Base.astro";
import { organizationLd } from "../lib/jsonld";
import { company, mynaFitUrl } from "../lib/site";

const site = Astro.site as URL;
// PRODUCT-OWNED copy (specs/myna-health.md, P-008, P-017). This is the company site: mission and
// vision first, the promises behind every product, then the portfolio. Each product has its own
// landing page, so product detail stays in the portfolio cards. Plain, human Bahasa Indonesia with
// "Anda"; no country framing (Erdi, 2026-10-21), no medical claims, prices or stats.
const foodMail = `mailto:${company.email}?subject=${encodeURIComponent("Kabari saya: Myna Food")}`;
const hello = `mailto:${company.email}`;

const portfolio = [
  {
    id: "myna-fit",
    name: "Myna Fit",
    status: "Tersedia",
    body: "Catat latihan dan makan Anda, lalu lihat perkembangannya dari minggu ke minggu.",
    photo: { src: "/images/gym-cek-hp.jpg", width: 1600, height: 1067, alt: "Perempuan duduk di gym sambil melihat HP", pos: "object-[45%_40%]" },
    cta: { href: mynaFitUrl, label: "Jadi Sehat Bareng", primary: true },
  },
  {
    id: "myna-food",
    name: "Myna Food",
    status: "Segera hadir",
    body: "Panduan makan sesuai tujuan Anda, dengan menu yang gampang dicari.",
    photo: { src: "/images/food-dapur.jpg", width: 1400, height: 1120, alt: "Pasangan menyiapkan sayur dan buah segar bersama di dapur", pos: "object-[42%_45%]" },
    cta: { href: foodMail, label: "Kabari saya saat rilis", primary: false },
  },
] as const;
---

<Base
  title="Myna Health"
  fullTitle="Myna Health — Aplikasi Gaya Hidup Sehat"
  description="Myna Health (PT Myna Bio Teknologi) membangun aplikasi wellness dan lifestyle: Myna Fit untuk pelacak kebugaran dan Myna Food untuk panduan makan sehat."
  jsonLd={[organizationLd(site)]}
  ground="white"
>
  <!-- 1. Hero: full-bleed photo, large white type, pill CTAs. -->
  <section data-drift-area class="relative isolate -mt-[68px] flex min-h-[640px] items-end overflow-hidden bg-navy text-white md:-mt-[80px] md:min-h-[min(100svh,900px)]" aria-labelledby="hero-title">
    <picture class="absolute inset-0 -z-10">
      <source media="(min-width: 768px)" srcset="/images/hero-pagi-wide.jpg" width="2400" height="1350" />
      <img src="/images/hero-pagi-tall.jpg" alt="Perempuan berpakaian olahraga di taman pagi hari, melihat HP sebelum berlatih" width="1000" height="1333" fetchpriority="high" class="h-full w-full object-cover object-[60%_30%] md:object-[50%_35%]" />
    </picture>
    <!-- P-018: a short muted loop of the same runner (Pexels 4458240). It has no src in the HTML:
         the script attaches it only on wide screens, with motion allowed and no Save-Data, and plays
         it only while the hero is on screen. Otherwise the photo above stays. -->
    <video data-hero-video class="absolute inset-0 -z-10 h-full w-full object-cover opacity-0 transition-opacity duration-700" muted loop playsinline preload="none" poster="/videos/hero-pagi-loop-poster.jpg" aria-hidden="true">
      <source data-src="/videos/hero-pagi-loop.webm" type="video/webm" />
      <source data-src="/videos/hero-pagi-loop.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 -z-10 bg-navy/50 md:bg-navy/25" aria-hidden="true"></div>
    <!-- Brand capsule cluster (guideline cover) with one Myna Fit chip, drifting slowly. Decorative. -->
    <div class="hero-rise pointer-events-none absolute right-[-48px] bottom-[-40px] flex items-end gap-3 md:right-[4%] md:bottom-[-24px] md:gap-4" aria-hidden="true">
      <span class="drift capsule block h-40 w-16 bg-sky md:h-64 md:w-24" style="--d:-1s"></span>
      <span class="flex flex-col gap-3 md:gap-4">
        <span class="drift block h-16 w-16 rounded-full bg-cyan md:h-24 md:w-24" style="--d:-3s"></span>
        <span class="drift capsule block h-52 w-16 bg-electric md:h-80 md:w-24"></span>
      </span>
      <span class="drift capsule hidden h-36 w-24 bg-cyan/90 md:block" style="--d:-2s"></span>
    </div>
    <p class="drift pointer-events-none absolute top-[30%] right-[6%] hidden items-center gap-2 rounded-full bg-white px-4 py-2.5 text-[14px] font-semibold text-navy shadow-[0_10px_30px_rgb(3_43_132/0.25)] lg:flex" style="--d:-4s" aria-hidden="true">
      Latihan hari ini <span class="rounded-full bg-cyan px-2 py-0.5 text-[12px]">Selesai</span>
    </p>
    <div class="container-home relative w-full pt-36 pb-14 md:pb-20">
      <div class="hero-rise">
        <h1 id="hero-title" class="rv-display max-w-[13ch] text-white lg:max-w-none">Kebiasaan kecil,<br class="hidden lg:block" /> <span class="text-cyan">setiap hari.</span></h1>
        <p class="rv-lead mt-6 max-w-[34ch] text-white">Kami merancang aplikasi yang membuat hidup sehat lebih gampang dijalani.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#produk" class="btn-light">Lihat produk kami</a>
          <a href="/tentang/" class="btn-glass-light">Tentang kami</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Mission, set like a thesis: one large statement and one paragraph. -->
  <section class="py-20 md:py-32" aria-labelledby="mission-title">
    <div class="container-home">
      <p class="text-[13px] font-semibold tracking-[0.08em] text-electric uppercase">Misi kami</p>
      <h2 id="mission-title" class="mt-5 max-w-[18ch] text-[34px] leading-[1.05] font-semibold tracking-[-0.025em] md:text-[60px]">Kebanyakan orang berhenti bukan karena malas.</h2>
      <p class="rv-lead mt-8 max-w-[52ch] text-muted-foreground md:text-[20px]">Programnya saja yang terlalu berat. Makanya kami mulai dari langkah kecil yang bisa Anda lakukan hari ini, dan gampang diulang besok.</p>
    </div>
  </section>

  <!-- 3. Vision on a full-bleed photo, framed by drifting brand capsules. -->
  <section data-drift-area class="relative isolate flex min-h-[520px] items-center overflow-hidden bg-navy text-white md:min-h-[640px]" aria-labelledby="vision-title">
    <img src="/images/momen-stretching-wide.jpg" alt="Dua orang melakukan peregangan lengan bersama di luar ruangan" width="2400" height="1350" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_40%]" />
    <div class="absolute inset-0 -z-10 bg-navy/55" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <span class="drift capsule absolute -top-16 -left-10 block h-64 w-24 rotate-[24deg] bg-cyan md:h-80 md:w-28"></span>
      <span class="drift absolute top-10 right-[8%] block h-16 w-16 rounded-full bg-sky md:h-24 md:w-24" style="--d:-2s"></span>
      <span class="drift capsule absolute -right-8 -bottom-20 block h-64 w-24 rotate-[-20deg] bg-electric md:h-80 md:w-28" style="--d:-4s"></span>
      <span class="drift absolute bottom-12 left-[12%] hidden h-12 w-12 rounded-full bg-cyan/90 md:block" style="--d:-3s"></span>
    </div>
    <div class="container-home py-20 text-center">
      <p class="text-[13px] font-semibold tracking-[0.08em] text-cyan uppercase">Visi</p>
      <h2 id="vision-title" class="rv-h2 mx-auto mt-5 max-w-[22ch] text-white">Setiap orang punya cara yang mudah untuk hidup lebih sehat, <span class="text-cyan">kapan pun dan di mana pun.</span></h2>
    </div>
  </section>

  <!-- 4. Promises behind every product, each with a small live illustration (bento on navy). -->
  <section class="bg-navy py-20 text-white md:py-28" aria-labelledby="promises-title">
    <div class="container-home">
      <h2 id="promises-title" class="rv-h2 max-w-[16ch] text-white">Janji kami untuk Anda</h2>
      <Promises />
    </div>
  </section>

  <!-- 5. Portfolio: products are part of the company, each with its own landing page. -->
  <section id="produk" class="scroll-mt-24 py-20 md:py-28" aria-labelledby="products-title">
    <div class="container-home">
      <h2 id="products-title" class="rv-h2">Produk kami</h2>
      <p class="rv-lead mt-4 max-w-[44ch] text-muted-foreground">Tiap produk fokus pada satu kebiasaan, dan punya halamannya sendiri.</p>
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {
          portfolio.map((p) => (
            <li id={p.id} class="flex scroll-mt-24 flex-col">
              <div class="aspect-[4/3] overflow-hidden rounded-[20px] bg-soft">
                <img src={p.photo.src} alt={p.photo.alt} width={p.photo.width} height={p.photo.height} loading="lazy" class:list={["h-full w-full object-cover", p.photo.pos]} />
              </div>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <h3 class="rv-h3">{p.name}</h3>
                <p class:list={["rounded-full px-3 py-1 text-xs font-semibold", p.status === "Tersedia" ? "bg-soft text-navy" : "bg-badge text-white"]}>{p.status}</p>
              </div>
              <p class="mt-2 text-[16px] leading-[1.55] text-muted-foreground">{p.body}</p>
              <p class="mt-5">{p.cta.primary ? <a href={p.cta.href} class="btn-primary">{p.cta.label}</a> : <a href={p.cta.href} class="text-link">{p.cta.label}</a>}</p>
            </li>
          ))
        }
        <li class="flex flex-col">
          <div class="flex aspect-[4/3] items-center justify-center gap-3 overflow-hidden rounded-[20px] bg-soft" aria-hidden="true">
            <span class="capsule block h-32 w-14 bg-sky" />
            <span class="capsule mt-12 block h-32 w-14 bg-electric" />
            <span class="capsule block h-14 w-14 bg-cyan" />
          </div>
          <h3 class="rv-h3 mt-5">Berikutnya</h3>
          <p class="mt-2 text-[16px] leading-[1.55] text-muted-foreground">Produk baru sedang kami kembangkan.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- 6. Closing: one photo card and one line, partnership by email. -->
  <section class="pb-20 md:pb-28" aria-labelledby="cta-title">
    <div class="container-home">
      <div data-cta class="relative isolate flex min-h-[420px] items-end overflow-hidden rounded-[20px] bg-navy p-8 text-white md:min-h-[460px] md:p-14">
        <img src="/images/hero-jogging-pontianak.jpg" alt="Dua pelari tersenyum saat jogging pagi bersama di jalan kota" width="1120" height="1400" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_30%]" />
        <div class="absolute inset-0 -z-10 bg-navy/50" aria-hidden="true"></div>
        <div data-cta-item>
          <h2 id="cta-title" class="rv-h2 max-w-[14ch] text-white">Hubungi kami untuk kerja sama.</h2>
          <p class="mt-8"><a href={hello} class="btn-light">{company.email}</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // P-015/P-017 (Motion). The hero copy settles in on load and the closing card's copy rises once
  // in view. Nothing else moves. Without JS or with reduced motion everything is at rest.
  import { animate, EASE, inView, motionOk } from "../scripts/motion";

  if (motionOk()) {
    if (performance.now() < 550) {
      // Hero: take over from the delayed CSS fallback while it is still waiting.
      document.querySelectorAll<HTMLElement>(".hero-rise").forEach((el) => {
        el.style.animation = "none";
        animate(el, { opacity: [0, 1], transform: ["translateY(24px)", "translateY(0px)"] }, { duration: 0.7, delay: 0.05, ease: EASE });
      });
    }

    // Hero video (P-018): only on wide screens and without Save-Data; plays while the hero is on
    // screen and pauses when it leaves. It fades in over the photo once it is actually playing.
    const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (video && matchMedia("(min-width: 768px)").matches && !saveData) {
      for (const source of video.querySelectorAll<HTMLSourceElement>("source[data-src]")) source.src = source.dataset.src ?? "";
      video.load();
      video.addEventListener("playing", () => video.classList.remove("opacity-0"), { once: true });
      const hero = video.closest("section");
      if (hero)
        inView(hero, () => {
          video.play().catch(() => {});
          return () => video.pause();
        });
    }

    // Drifting brand capsules (hero, vision): move only while their section is on screen.
    for (const area of document.querySelectorAll<HTMLElement>("[data-drift-area]")) {
      inView(area, () => {
        area.dataset.play = "";
        return () => delete area.dataset.play;
      });
    }

    // Closing card: rises once, only if it starts below the fold.
    const panel = document.querySelector<HTMLElement>("[data-cta]");
    if (panel && panel.getBoundingClientRect().top > window.innerHeight) {
      const items = [...panel.querySelectorAll<HTMLElement>("[data-cta-item]")];
      for (const el of items) {
        el.style.opacity = "0";
        el.style.transform = "translateY(18px)";
      }
      const stop = inView(
        panel,
        () => {
          items.forEach((el, i) => animate(el, { opacity: [0, 1], transform: ["translateY(18px)", "translateY(0px)"] }, { duration: 0.6, delay: i * 0.08, ease: EASE }));
          stop();
        },
        { amount: 0.3 },
      );
    }
  }
</script>
