---
import CompanyIdentity from "../components/CompanyIdentity.astro";
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { organizationLd } from "../lib/jsonld";
import { company, disclaimer, foundedYear, mynaFitUrl, values } from "../lib/site";

const site = Astro.site as URL;
const missions = [
  "Mengembangkan produk digital yang sederhana dan nyaman digunakan setiap hari.",
  "Menyajikan informasi gaya hidup yang jelas dan bertanggung jawab, tanpa klaim medis.",
  "Melindungi data pengguna sesuai UU Pelindungan Data Pribadi.",
  "Mengembangkan portofolio produk sesuai kebutuhan pengguna di Indonesia.",
];
const products = [
  { name: "Myna Fit", status: "Tersedia", body: "Pelacak latihan gym dan catatan kalori dalam satu aplikasi.", href: mynaFitUrl, cta: "fit.mynahealth.id" },
  { name: "Myna Food", status: "Segera hadir", body: "Panduan makan sesuai tujuan: diet, tinggi protein, atau pola makan seimbang.", href: "/#myna-food", cta: "Lihat detail" },
];
const h2 = "text-[28px] leading-[1.2] font-bold text-foreground md:text-[36px]";
---

<Base title="Tentang Kami" description={`Profil ${company.name}, perusahaan di balik Myna Health: visi, misi, prinsip, portofolio produk (Myna Fit, Myna Food), dan identitas perusahaan.`} og="tentang" jsonLd={[organizationLd(site)]}>
  <PageHeader label="Tentang Kami" title="Profil perusahaan" description={`Myna Health adalah merek milik ${company.name}, perusahaan teknologi wellness dan lifestyle yang didirikan pada ${foundedYear} di Depok.`} />

  <section class="section-padding">
    <div class="container-myna grid max-w-6xl gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
      <div class="space-y-5 text-[17px] leading-relaxed text-foreground/80">
        <p class="section-label">Siapa kami</p>
        <h2 class={h2}>Membuat kebiasaan sehat <span class="text-primary">lebih mudah dijalani.</span></h2>
        <p>Banyak orang ingin lebih aktif dan makan lebih teratur, tetapi sulit menjaganya secara konsisten. Kami percaya kuncinya ada pada alat yang sederhana dan relevan dengan keseharian.</p>
        <p>
          Karena itu setiap produk kami berfokus pada satu kebiasaan. <strong class="text-foreground">Myna Fit</strong> membantu mencatat latihan dan kalori harian.
          <strong class="text-foreground">Myna Food</strong>, yang segera hadir, membantu memilih menu sesuai tujuan.
        </p>
        <p>Seluruh produk Myna dikembangkan dan dikelola oleh {company.name}, yang didirikan pada {foundedYear} dan berkantor di Kota Depok, Jawa Barat.</p>
        <p class="rounded-2xl border border-border bg-card p-5 text-sm text-muted-foreground">{disclaimer}</p>
      </div>
      <aside class="space-y-4">
        <div class="rounded-3xl bg-accent p-7">
          <p class="mb-2 text-xs font-semibold tracking-[0.15em] text-accent-foreground/70 uppercase">Visi</p>
          <p class="text-xl leading-snug font-semibold text-foreground">Menjadi pendamping sehari-hari masyarakat Indonesia untuk menjalani hidup yang lebih sehat.</p>
        </div>
        <div class="rounded-3xl border border-border bg-card p-7">
          <p class="mb-3 text-xs font-semibold tracking-[0.15em] text-muted-foreground uppercase">Misi</p>
          <ul class="space-y-3">
            {missions.map((m) => (
              <li class="flex items-start gap-3 text-[15px] leading-snug text-foreground/80">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15"><Icon name="check" class="h-3.5 w-3.5 text-primary" /></span>
                {m}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <div class="container-myna max-w-6xl pb-16 md:pb-24">
    <div class="aspect-[16/7] overflow-hidden rounded-3xl">
      <img src="/images/lifestyle-piknik.jpg" alt="Teman-teman piknik bersama di taman dengan buah segar" width="1400" height="1120" loading="lazy" class="h-full w-full object-cover" />
    </div>
  </div>

  <section class="section-padding pt-0 md:pt-0" aria-labelledby="portfolio-title">
    <div class="container-myna max-w-6xl">
      <p class="section-label mb-3">Produk</p>
      <h2 id="portfolio-title" class:list={[h2, "mb-8"]}>Portofolio produk</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {products.map((p) => (
          <a href={p.href} class="group flex flex-col rounded-2xl border border-border bg-card p-6 transition-all duration-200 hover:scale-[1.01] hover:shadow-lg">
            <div class="mb-3 flex items-center justify-between gap-3">
              <h3 class="card-title">{p.name}</h3>
              <span class:list={["rounded-full px-3 py-1 text-xs font-semibold", p.status === "Tersedia" ? "bg-accent text-accent-foreground" : "bg-food text-white"]}>{p.status}</span>
            </div>
            <p class="card-desc mb-5">{p.body}</p>
            <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-primary">{p.cta} <Icon name="arrow-right" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding pt-0 md:pt-0" aria-labelledby="values-title">
    <div class="container-myna max-w-6xl">
      <p class="section-label mb-3">Prinsip kami</p>
      <h2 id="values-title" class:list={[h2, "mb-8"]}>Cara kami membangun produk</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="rounded-2xl border border-border bg-card p-6">
            <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent text-primary"><Icon name={v.icon} class="h-5 w-5" /></span>
            <h3 class="card-title mb-2">{v.title}</h3>
            <p class="card-desc">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding pt-0 md:pt-0" aria-labelledby="identity-title">
    <div class="container-myna max-w-4xl">
      <h2 id="identity-title" class="sr-only">Identitas perusahaan</h2>
      <CompanyIdentity />
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/kontak/" class="inline-flex h-12 items-center gap-2 rounded-full bg-primary px-8 text-[15px] font-semibold text-primary-foreground shadow-lg transition-all hover:scale-[1.02] hover:shadow-xl">Hubungi kami <Icon name="arrow-right" /></a>
        <a href={mynaFitUrl} class="inline-flex h-12 items-center rounded-full border-2 border-primary px-8 text-[15px] font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground">Buka Myna Fit</a>
      </div>
    </div>
  </section>
</Base>
