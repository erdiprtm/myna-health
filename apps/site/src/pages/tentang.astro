---
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { organizationLd } from "../lib/jsonld";
import { company, companyAddress, disclaimer, mynaFitUrl } from "../lib/site";

const site = Astro.site as URL;
const values = [
  { title: "Sederhana", body: "Fitur secukupnya agar mencatat terasa ringan, bukan beban." },
  { title: "Dekat dengan keseharian", body: "Bahasa Indonesia sehari-hari dan pilihan makanan yang akrab." },
  { title: "Menghargai privasi", body: "Data kamu milikmu. Kami tidak menjual data pribadi." },
];
---

<Base title="Tentang Kami" description={`Myna Health adalah merek aplikasi gaya hidup sehat dari ${company.name}: Myna Fit untuk latihan dan kalori, Myna Food untuk panduan makan.`} og="tentang" jsonLd={[organizationLd(site)]}>
  <PageHeader label="Tentang Kami" title="Membuat hidup sehat terasa mudah" description="Myna Health adalah merek aplikasi gaya hidup sehat untuk orang Indonesia." />
  <section class="section-padding">
    <div class="container-myna grid max-w-5xl gap-12 lg:grid-cols-[3fr_2fr]">
      <div class="space-y-5 text-[17px] leading-relaxed text-foreground/80">
        <p>
          Banyak orang ingin lebih aktif dan makan lebih teratur, tetapi bingung mulai dari mana dan sulit menjaga konsistensi.
          Myna Health hadir untuk membantu lewat aplikasi yang sederhana dan bisa dipakai setiap hari.
        </p>
        <p>
          <strong class="text-foreground">Myna Fit</strong> membantu kamu mencatat latihan gym dan kalori harian, lalu melihat progresnya dari waktu ke waktu.
          <strong class="text-foreground">Myna Food</strong>, yang segera hadir, akan memberi panduan makan sesuai tujuan, seperti diet atau tinggi protein.
        </p>
        <p>Myna Health dikembangkan dan dikelola oleh <strong class="text-foreground">{company.name}</strong>, perusahaan yang berkedudukan di Kota Depok, Jawa Barat.</p>
        <p class="rounded-2xl border border-border bg-card p-5 text-sm text-muted-foreground">{disclaimer}</p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href={mynaFitUrl} class="inline-flex h-12 items-center gap-2 rounded-full bg-myna-navy px-8 text-[15px] font-semibold text-white shadow-lg transition-all hover:scale-[1.02] hover:shadow-xl">Buka Myna Fit <Icon name="arrow-right" /></a>
          <a href="/kontak/" class="inline-flex h-12 items-center rounded-full border-2 border-primary px-8 text-[15px] font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground">Hubungi kami</a>
        </div>
      </div>
      <aside class="space-y-6">
        <div class="rounded-2xl border border-border bg-card p-6">
          <h2 class="card-title mb-4">Identitas perusahaan</h2>
          <dl class="space-y-3 text-sm">
            <div class="flex gap-3"><Icon name="building" class="mt-0.5 h-4 w-4 text-primary" /><div><dt class="sr-only">Nama perusahaan</dt><dd class="font-semibold text-foreground">{company.name}</dd></div></div>
            <div class="flex gap-3"><Icon name="map-pin" class="mt-0.5 h-4 w-4 text-primary" /><div><dt class="sr-only">Alamat</dt><dd class="text-muted-foreground">{companyAddress}</dd></div></div>
            <div class="flex gap-3"><Icon name="mail" class="mt-0.5 h-4 w-4 text-primary" /><div><dt class="sr-only">Email</dt><dd><a href={`mailto:${company.email}`} class="text-foreground underline underline-offset-4">{company.email}</a></dd></div></div>
          </dl>
        </div>
        <div class="space-y-3">
          {values.map((v) => (
            <div class="rounded-2xl border border-border bg-card p-5">
              <h3 class="mb-1 font-semibold text-foreground">{v.title}</h3>
              <p class="card-desc">{v.body}</p>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>
</Base>
