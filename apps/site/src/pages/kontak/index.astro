---
import ContactInfo from "../../components/ContactInfo.astro";
import Faq from "../../components/Faq.astro";
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { faqLd } from "../../lib/jsonld";
import { company, product } from "../../lib/site";
// Contact is by email only (Erdi, 2026-10-12): no form, nothing stored on the site.
---

<Base title="Kontak" description={`Hubungi ${company.name}, pengelola ${product.name}, untuk pertanyaan produk, kerja sama, atau data pribadi. Email ${company.email}.`} og="kontak" jsonLd={[faqLd()]}>
  <PageHeader label="Kontak" title="Hubungi kami" description="Untuk pertanyaan produk, kerja sama, atau permintaan terkait data pribadi, kirim email kepada kami." />
  <section class="py-14 md:py-20">
    <div class="container-myna grid gap-14 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7">
        <div class="card-outline p-8 md:p-10">
          <h2 class="text-xl font-bold">Email resmi</h2>
          <p class="mt-4"><a href={`mailto:${company.email}`} class="text-[26px] font-extrabold tracking-[-0.02em] text-navy underline decoration-navy/25 underline-offset-[6px] hover:decoration-navy md:text-[32px]">{company.email}</a></p>
          <p class="body-copy mt-4 max-w-[52ch]">Sertakan nama Anda dan topik pesan di baris subjek agar kami dapat membalas lebih cepat.</p>
          <a href={`mailto:${company.email}`} class="btn-primary mt-8">Kirim email</a>
        </div>
      </div>
      <div class="md:col-span-4 md:col-start-9"><ContactInfo /></div>
    </div>
  </section>
  <section class="border-t border-border py-14 md:py-20" aria-labelledby="faq-title">
    <div class="container-myna grid gap-8 md:grid-cols-12">
      <h2 id="faq-title" class="h-section md:col-span-4">Pertanyaan umum</h2>
      <div class="md:col-span-8"><Faq /></div>
    </div>
  </section>
</Base>
