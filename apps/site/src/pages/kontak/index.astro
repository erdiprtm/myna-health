---
import ContactInfo from "../../components/ContactInfo.astro";
import Faq from "../../components/Faq.astro";
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { faqLd } from "../../lib/jsonld";
import { company, contactEndpoint, product } from "../../lib/site";

const field =
  "mt-2 block w-full rounded-md border border-input bg-card px-3.5 py-3 text-[16px] text-foreground placeholder:text-muted-foreground/80 transition-colors duration-150 hover:border-foreground/40 focus:border-primary focus:outline-2 focus:outline-offset-0 focus:outline-ring/25";
---

<Base title="Kontak" description={`Hubungi ${company.name}, pengelola ${product.name}, untuk pertanyaan produk, kerja sama, atau data pribadi. Email ${company.email}.`} og="kontak" jsonLd={[faqLd()]}>
  <PageHeader label="Kontak" title="Hubungi kami" description="Untuk pertanyaan produk, kerja sama, atau permintaan terkait data pribadi, kirim pesan di bawah ini. Kami membalas melalui email." />
  <section class="py-14 md:py-20">
    <div class="container-myna grid gap-14 md:grid-cols-12 md:gap-8">
      <form method="post" action={contactEndpoint} class="md:col-span-7" aria-labelledby="form-title">
        <h2 id="form-title" class="text-xl font-semibold tracking-[-0.01em]">Kirim pesan</h2>
        <p class="mt-2 text-[15px] text-muted-foreground">Pesan Anda diteruskan ke {company.email}.</p>
        <div class="mt-8 space-y-6">
          <div class="grid gap-6 sm:grid-cols-2">
            <label class="block text-[15px] font-medium text-foreground">
              Nama
              <input class={field} type="text" name="name" required maxlength="100" autocomplete="name" />
            </label>
            <label class="block text-[15px] font-medium text-foreground">
              Email
              <input class={field} type="email" name="email" required maxlength="200" autocomplete="email" placeholder="nama@email.com" />
            </label>
          </div>
          <label class="block text-[15px] font-medium text-foreground">
            Pesan
            <textarea class={field} name="message" required minlength="10" maxlength="5000" rows="7"></textarea>
          </label>
          <!-- Spam trap: hidden from people, bots fill it in. -->
          <div class="hidden" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <p class="max-w-[60ch] text-sm leading-relaxed text-muted-foreground">
            Dengan mengirim pesan, Anda setuju data di atas dipakai untuk membalas pesan Anda sesuai <a href="/privasi/" class="text-link font-normal">Kebijakan Privasi</a>.
          </p>
          <button type="submit" class="btn-primary w-full cursor-pointer px-7 sm:w-auto">Kirim pesan</button>
        </div>
      </form>
      <div class="md:col-span-4 md:col-start-9"><ContactInfo /></div>
    </div>
  </section>
  <section class="border-t border-border py-14 md:py-20" aria-labelledby="faq-title">
    <div class="container-myna grid gap-8 md:grid-cols-12">
      <h2 id="faq-title" class="h-section md:col-span-4">Pertanyaan umum</h2>
      <div class="md:col-span-8"><Faq /></div>
    </div>
  </section>
</Base>
